{
    "name": "PL_Copy_Customer_To_Bronze",
    "properties": {
        "activities": [
            {
                "name": "Lookup_Active_Tables",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderQuery": "SELECT\n    TableName,\n    SourceSchema,\n    SourceTable,\n    SinkFolder,\n    WatermarkColumn,\n    LastWatermarkValue,\n    FullLoadFileName,\n    LoadType\nFROM etl.WatermarkControl\nWHERE IsActive = 1;",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_SQL_WatermarkControl",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "ForEach_Active_Tables",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Lookup_Active_Tables",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Lookup_Active_Tables').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "Copy_Table_To_Bronze",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "SqlServerSource",
                                    "sqlReaderQuery": {
                                        "value": "@if(\n    equals(item().LoadType, 'Full'),\n    concat('SELECT * FROM [', item().SourceSchema, '].[', item().SourceTable, ']'),\n    concat(\n        'SELECT * FROM [',\n        item().SourceSchema,\n        '].[',\n        item().SourceTable,\n        '] WHERE [',\n        item().WatermarkColumn,\n        '] >= CONVERT(datetime2(3), ''',\n        formatDateTime(item().LastWatermarkValue, 'yyyy-MM-ddTHH:mm:ss.fff'),\n        ''', 126)'\n    )\n)",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_SQL_AdventureWorks_Source",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "SchemaName": {
                                            "value": "@item().SourceSchema",
                                            "type": "Expression"
                                        },
                                        "TableName": {
                                            "value": "@item().SourceTable",
                                            "type": "Expression"
                                        },
                                        "WatermarkValue": {
                                            "value": "@string(item().LastWatermarkValue)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_AdventureWorks_Bronze",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "DirectoryPath": {
                                            "value": "@if(equals(item().LoadType, 'Full'), item().SinkFolder, concat(item().SinkFolder, '/incremental'))",
                                            "type": "Expression"
                                        },
                                        "FileName": {
                                            "value": "@if(equals(item().LoadType, 'Full'), item().FullLoadFileName, concat(item().SourceTable, '_', pipeline().RunId, '.parquet'))",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Update_Watermark",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Copy_Table_To_Bronze",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[etl].[usp_UpdateWatermark]",
                                "storedProcedureParameters": {
                                    "TableName": {
                                        "value": {
                                            "value": "@item().TableName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "LS_SQLServer_AdventureWorks",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "Audit_Load_Success",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Update_Watermark",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[etl].[usp_InsertLoadAudit]",
                                "storedProcedureParameters": {
                                    "EndTime": {
                                        "value": {
                                            "value": "@utcNow()",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "ErrorMessage": {
                                        "value": "",
                                        "type": "String"
                                    },
                                    "ExtractedRecords": {
                                        "value": {
                                            "value": "@activity('Copy_Table_To_Bronze').output.rowsCopied",
                                            "type": "Expression"
                                        },
                                        "type": "Int64"
                                    },
                                    "LoadStatus": {
                                        "value": {
                                            "value": "Succeeded",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "LoadType": {
                                        "value": {
                                            "value": "@item().LoadType",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "PipelineRunID": {
                                        "value": {
                                            "value": "@pipeline().RunId",
                                            "type": "Expression"
                                        },
                                        "type": "Guid"
                                    },
                                    "StartTime": {
                                        "value": {
                                            "value": "@activity('Copy_Table_To_Bronze').output.executionDetails[0].start",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "TableName": {
                                        "value": {
                                            "value": "@item().TableName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "LS_SQLServer_AdventureWorks",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "Audit_Load_Failure",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Copy_Table_To_Bronze",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[etl].[usp_InsertLoadAudit]",
                                "storedProcedureParameters": {
                                    "EndTime": {
                                        "value": {
                                            "value": "@utcNow()",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "ErrorMessage": {
                                        "value": {
                                            "value": "@string(activity('Copy_Table_To_Bronze').error.message)",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "ExtractedRecords": {
                                        "value": {
                                            "value": "0",
                                            "type": "Expression"
                                        },
                                        "type": "Int64"
                                    },
                                    "LoadStatus": {
                                        "value": "Failed",
                                        "type": "String"
                                    },
                                    "LoadType": {
                                        "value": {
                                            "value": "@item().LoadType",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "PipelineRunID": {
                                        "value": {
                                            "value": "@pipeline().RunId",
                                            "type": "Expression"
                                        },
                                        "type": "Guid"
                                    },
                                    "StartTime": {
                                        "value": {
                                            "value": "@pipeline().TriggerTime",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "TableName": {
                                        "value": {
                                            "value": "@item().TableName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "LS_SQLServer_AdventureWorks",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "Fail_Pipeline_On_Copy_Error",
                            "type": "Fail",
                            "dependsOn": [
                                {
                                    "activity": "Audit_Load_Failure",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "errorCode": "BRONZE_COPY_FAILED",
                                "message": "@concat('Copy failed for ', item().SourceSchema, '.', item().SourceTable, ': ', string(activity('Copy_Table_To_Bronze').error.message))"
                            }
                        },
                        {
                            "name": "Audit_Watermark_Failure",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Update_Watermark",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[etl].[usp_InsertLoadAudit]",
                                "storedProcedureParameters": {
                                    "EndTime": {
                                        "value": {
                                            "value": "@utcNow()",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "ErrorMessage": {
                                        "value": {
                                            "value": "@string(activity('Update_Watermark').error.message)",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "ExtractedRecords": {
                                        "value": {
                                            "value": "@activity('Copy_Table_To_Bronze').output.rowsCopied",
                                            "type": "Expression"
                                        },
                                        "type": "Int64"
                                    },
                                    "LoadStatus": {
                                        "value": "Failed",
                                        "type": "String"
                                    },
                                    "LoadType": {
                                        "value": {
                                            "value": "@item().LoadType",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "PipelineRunID": {
                                        "value": {
                                            "value": "@pipeline().RunId",
                                            "type": "Expression"
                                        },
                                        "type": "Guid"
                                    },
                                    "StartTime": {
                                        "value": {
                                            "value": "@activity('Copy_Table_To_Bronze').output.executionDetails[0].start",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "TableName": {
                                        "value": {
                                            "value": "@item().TableName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "LS_SQLServer_AdventureWorks",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "Fail_Pipeline_On_Watermark_Error",
                            "type": "Fail",
                            "dependsOn": [
                                {
                                    "activity": "Audit_Watermark_Failure",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "errorCode": "WATERMARK_UPDATE_FAILED",
                                "message": "@concat('Watermark update failed for ', item().TableName, ': ', string(activity('Update_Watermark').error.message))"
                            }
                        }
                    ]
                }
            }
        ],
        "annotations": [],
        "lastPublishTime": "2026-11-20T20:25:41Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}